# نسخة مثال من متغيرات البيئة — لا تضع هنا أي مفاتيح حقيقية.
# انسخ هذا الملف إلى .env.local وضع القيم الفعلية هناك فقط (ملف .env.local غير مُتتبَّع في Git).

# Supabase (سيتم تفعيلها في مرحلة لاحقة)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# طبقة AI — server-side فقط، لا تضع NEXT_PUBLIC_ أمام أي منها.
# AI_PROVIDER: "mock" (افتراضي وآمن) أو "openai".
AI_PROVIDER=
OPENAI_API_KEY=
